# 复制为 dev.env；仅真实 *.env 文件放入私密值，不提交到 Git。
APP_ENV=dev
HOST_BIND_ADDRESS=127.0.0.1
HOST_PORT=7588

# 必填：开发环境数据库、Redis 与 JWT（HS512 密钥至少 64 字符）
DB_URL=jdbc:mysql://host.docker.internal:3306/junoyi?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true
DB_USERNAME=root
DB_PASSWORD=
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DATABASE=1
# 仅当 Redis 启用认证时取消下一行注释并填写密码
# SPRING_DATA_REDIS_PASSWORD=
REDIS_KEY_PREFIX=junoyi:dev
JWT_SECRET=

# Token 配置；有效期支持 m（分钟）、h（小时）、d（天）。
TOKEN_HEADER=Authorization
TOKEN_SINGLE_LOGIN=false
TOKEN_ACCESS_EXPIRE_ADMIN_WEB=30m
TOKEN_ACCESS_EXPIRE_FRONT_WEB=2h
TOKEN_ACCESS_EXPIRE_MINIPROGRAM=12h
TOKEN_ACCESS_EXPIRE_APP=24h
TOKEN_ACCESS_EXPIRE_DESKTOP=7d
TOKEN_REFRESH_EXPIRE_ADMIN_WEB=3d
TOKEN_REFRESH_EXPIRE_FRONT_WEB=7d
TOKEN_REFRESH_EXPIRE_MINIPROGRAM=30d
TOKEN_REFRESH_EXPIRE_APP=30d
TOKEN_REFRESH_EXPIRE_DESKTOP=90d

# 对外地址与跨域配置；列表用逗号分隔，不加空格。
FILE_DOMAIN=http://localhost:7588
CORS_ENABLED=true
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_ORIGINS=http://localhost:3006
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Encrypted,X-No-Encrypt

# 开发环境便于调试
LOG_ROOT_LEVEL=INFO
LOG_JUNOYI_LEVEL=DEBUG
LOG_SQL_LEVEL=DEBUG
LOG_FILE_ENABLED=true
# LOG_FILE_PATH=/app/data/logs
# FILE_LOCAL_BASE_PATH=/app/data/uploads
SQL_LOG_ENABLED=true
ACCESS_LOG_REQUEST_PARAMS=true
API_DOC_ENABLED=true
XSS_MODE=clean
API_ENCRYPT_ENABLED=false
DB_POOL_INITIAL_SIZE=2
DB_POOL_MIN_IDLE=2
DB_POOL_MAX_ACTIVE=20

# 可选：启用对应模块时填写。证书文件放在 deploy/backend/config/certs/。
# FILE_STORAGE_TYPE=local
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET_NAME=
# OSS_ENDPOINT=
# OSS_CUSTOM_DOMAIN=
# MINIO_ENDPOINT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET_NAME=
# WEWORK_ENABLED=false
# WEWORK_CORP_ID=
# WEWORK_AGENT_ID=
# WEWORK_SECRET=
# WEWORK_REDIRECT_URI=
# WEWORK_TOKEN_STORE_TYPE=memory
# JUNOYI_WEWORK_GROUPBOT_WEBHOOKS_0=
# WECHAT_MP_ENABLED=false
# WECHAT_MP_APP_ID=
# WECHAT_MP_SECRET=
# WECHAT_PAY_ENABLED=false
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MERCHANT_ID=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_PRIVATE_KEY_PATH=/app/config/certs/apiclient_key.pem
# WECHAT_PAY_PRIVATE_CERT_PATH=/app/config/certs/apiclient_cert.pem
# WECHAT_PAY_CERT_SERIAL_NO=
# WECHAT_PAY_NOTIFY_URL=
# WECHAT_REFUND_NOTIFY_URL=
