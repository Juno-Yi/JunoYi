# 复制为 prod.env；所有域名、地址、账号和密钥必须替换为生产值。
APP_ENV=prod
HOST_BIND_ADDRESS=127.0.0.1
HOST_PORT=7590

DB_URL=jdbc:mysql://prod-mysql.example.invalid:3306/junoyi?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true&rewriteBatchedStatements=true
DB_USERNAME=
DB_PASSWORD=
REDIS_HOST=prod-redis.example.invalid
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=junoyi:prod
JWT_SECRET=

# Token 配置；有效期支持 m（分钟）、h（小时）、d（天）。
TOKEN_HEADER=Authorization
TOKEN_SINGLE_LOGIN=false
TOKEN_ACCESS_EXPIRE_ADMIN_WEB=30m
TOKEN_ACCESS_EXPIRE_FRONT_WEB=2h
TOKEN_ACCESS_EXPIRE_MINIPROGRAM=12h
TOKEN_ACCESS_EXPIRE_APP=24h
TOKEN_ACCESS_EXPIRE_DESKTOP=7d
TOKEN_REFRESH_EXPIRE_ADMIN_WEB=3d
TOKEN_REFRESH_EXPIRE_FRONT_WEB=7d
TOKEN_REFRESH_EXPIRE_MINIPROGRAM=30d
TOKEN_REFRESH_EXPIRE_APP=30d
TOKEN_REFRESH_EXPIRE_DESKTOP=90d

FILE_DOMAIN=https://api.example.com
CORS_ENABLED=true
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Encrypted,X-No-Encrypt

LOG_ROOT_LEVEL=INFO
LOG_JUNOYI_LEVEL=INFO
LOG_SQL_LEVEL=WARN
LOG_FILE_ENABLED=true
# LOG_FILE_PATH=/app/data/logs
# FILE_LOCAL_BASE_PATH=/app/data/uploads
SQL_LOG_ENABLED=false
ACCESS_LOG_REQUEST_PARAMS=false
API_DOC_ENABLED=false
XSS_MODE=reject
API_ENCRYPT_ENABLED=true
DB_POOL_INITIAL_SIZE=10
DB_POOL_MIN_IDLE=10
DB_POOL_MAX_ACTIVE=50

# 可选集成：启用相应功能后填写实际值；证书放入 deploy/backend/config/certs/。
# FILE_STORAGE_TYPE=local
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET_NAME=
# OSS_ENDPOINT=
# OSS_CUSTOM_DOMAIN=
# MINIO_ENDPOINT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET_NAME=
# WEWORK_ENABLED=false
# WEWORK_CORP_ID=
# WEWORK_AGENT_ID=
# WEWORK_SECRET=
# WEWORK_REDIRECT_URI=
# WEWORK_TOKEN_STORE_TYPE=memory
# JUNOYI_WEWORK_GROUPBOT_WEBHOOKS_0=
# WECHAT_MP_ENABLED=false
# WECHAT_MP_APP_ID=
# WECHAT_MP_SECRET=
# WECHAT_PAY_ENABLED=false
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MERCHANT_ID=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_PRIVATE_KEY_PATH=/app/config/certs/apiclient_key.pem
# WECHAT_PAY_PRIVATE_CERT_PATH=/app/config/certs/apiclient_cert.pem
# WECHAT_PAY_CERT_SERIAL_NO=
# WECHAT_PAY_NOTIFY_URL=
# WECHAT_REFUND_NOTIFY_URL=
